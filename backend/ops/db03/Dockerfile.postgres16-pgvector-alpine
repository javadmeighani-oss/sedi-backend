# SEDI Production PostgreSQL 16 + pgvector — Alpine same-lineage packaging (Path A).
# Retains postgres:16-alpine UID/GID and PGDATA compatibility.
# Exact pgvector v0.8.6 compiled from source; extension files installed without PGXS bitcode.
ARG POSTGRES_BASE=postgres:16-alpine
FROM ${POSTGRES_BASE}

ARG PGVECTOR_VERSION=v0.8.6
LABEL org.opencontainers.image.title="sedi-postgres"
LABEL org.opencontainers.image.description="PostgreSQL 16 Alpine + pinned pgvector for SEDI Production"
LABEL sedi.pgvector.version="${PGVECTOR_VERSION}"
LABEL sedi.packaging.path="A_alpine_same_lineage_source_pin"

USER root
RUN set -eux; \
    apk add --no-cache --virtual .build-deps \
      build-base \
      clang \
      llvm-dev \
      git \
      postgresql-dev; \
    git clone --branch "${PGVECTOR_VERSION}" --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector; \
    cd /tmp/pgvector; \
    make OPTFLAGS=""; \
    test -f vector.so; \
    PKGLIB="$(pg_config --pkglibdir)"; \
    SHARE="$(pg_config --sharedir)/extension"; \
    mkdir -p "${PKGLIB}" "${SHARE}"; \
    cp -f vector.so "${PKGLIB}/vector.so"; \
    cp -f vector.control "${SHARE}/vector.control"; \
    cp -f sql/vector--*.sql "${SHARE}/"; \
    cd /; \
    rm -rf /tmp/pgvector; \
    apk del .build-deps; \
    CTRL="$(find /usr -name 'vector.control' 2>/dev/null | head -1)"; \
    SO="$(find /usr -name 'vector.so' 2>/dev/null | head -1)"; \
    test -n "${CTRL}"; \
    test -n "${SO}"; \
    grep -E '^default_version' "${CTRL}"; \
    echo "VECTOR_CONTROL=${CTRL}"; \
    echo "VECTOR_SO=${SO}"; \
    echo "PGVECTOR_INSTALL=source_${PGVECTOR_VERSION}_manual_ext_install"

# Keep default postgres entrypoint/user from base image.
