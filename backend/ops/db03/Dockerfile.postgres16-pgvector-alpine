# SEDI Production PostgreSQL 16 + pgvector — Alpine same-lineage (Path A).
# Canonical PGXS install with LLVM bitcode disabled (with_llvm=0).
ARG POSTGRES_BASE=postgres:16-alpine
FROM ${POSTGRES_BASE}

ARG PGVECTOR_VERSION=v0.8.6
LABEL org.opencontainers.image.title="sedi-postgres"
LABEL org.opencontainers.image.description="PostgreSQL 16 Alpine + pinned pgvector (canonical PGXS, no LLVM bitcode)"
LABEL sedi.pgvector.version="${PGVECTOR_VERSION}"
LABEL sedi.packaging.path="A_alpine_same_lineage_canonical_pgxs_no_llvm"

USER root
RUN set -eux; \
    apk add --no-cache --virtual .build-deps \
      build-base \
      git \
      postgresql-dev; \
    git clone --branch "${PGVECTOR_VERSION}" --depth 1 https://github.com/pgvector/pgvector.git /tmp/pgvector; \
    cd /tmp/pgvector; \
    make OPTFLAGS="" with_llvm=0; \
    make install with_llvm=0; \
    cd /; \
    rm -rf /tmp/pgvector; \
    apk del .build-deps; \
    PKGLIB="$(pg_config --pkglibdir)"; \
    SHARE="$(pg_config --sharedir)"; \
    echo "PG_CONFIG_VERSION=$(pg_config --version)"; \
    echo "PG_CONFIG_PKGLIBDIR=${PKGLIB}"; \
    echo "PG_CONFIG_SHAREDIR=${SHARE}"; \
    test -f "${PKGLIB}/vector.so"; \
    test -f "${SHARE}/extension/vector.control"; \
    test -n "$(ls "${SHARE}/extension"/vector--*.sql 2>/dev/null | head -1)"; \
    grep -E '^default_version' "${SHARE}/extension/vector.control"; \
    # Musl ldd reports postgres host symbols as "Error relocating ... not found" — expected for PG extensions.
    # Fail only if a shared library file itself is missing.
    ldd "${PKGLIB}/vector.so" | tee /tmp/vector_ldd.txt || true; \
    if grep -E '=>[[:space:]]+not found' /tmp/vector_ldd.txt; then echo "MISSING_SHARED_LIB"; exit 1; fi; \
    echo "VECTOR_SO_NO_MISSING_SHARED_LIBRARIES=PASS"; \
    echo "PGVECTOR_CANONICAL_PGXS_INSTALL=PASS"; \
    echo "PGVECTOR_LLVM_BITCODE_DISABLED=YES"; \
    echo "VECTOR_SO_PATH=${PKGLIB}/vector.so"; \
    echo "VECTOR_CONTROL_PATH=${SHARE}/extension/vector.control"

# Keep default postgres entrypoint/user from base image.
