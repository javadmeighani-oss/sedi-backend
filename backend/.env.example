# Sedi Backend - Environment variables
# Copy to .env and fill in values. Never commit .env to git.

# Database (required)
# DATABASE_URL=postgresql://user:pass@host:5432/sedi_db

# Auth & Security
# SECRET_KEY=your-64-byte-random-secret

# OTP / SMS (Mediana – production provider)
# Dev/local: keep SMS off and use dev_code from API response.
SMS_DISABLED=true
SMS_PROVIDER=dummy
# Production (server env only, e.g. /etc/sedi/sedi-backend.env):
# SMS_DISABLED=false
# SMS_PROVIDER=mediana
# MEDIANA_API_KEY=your-api-key-from-mediana-panel
# MEDIANA_OTP_PATTERN_CODE=your-otp-pattern-code
