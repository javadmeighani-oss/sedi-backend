# Sedi Backend - Environment variables
# Copy to .env and fill in values. Never commit .env to git.

# Database (required)
# DATABASE_URL=postgresql://user:pass@host:5432/sedi_db

# Auth & Security
# SECRET_KEY=your-64-byte-random-secret

# OTP / SMS (Kavenegar)
# Set KAVENEGAR_API_KEY to enable real SMS. Leave unset for dev (dev_code shown in app).
KAVENEGAR_API_KEY=your-api-key-from-kavenegar-panel
# KAVENEGAR_SENDER=1000xxxx
# SMS_DISABLED=true
