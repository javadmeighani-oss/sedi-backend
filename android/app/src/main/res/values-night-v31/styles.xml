<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash (night): no launcher icon, A1 first-frame palette. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/a1_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_brand</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/a1_launch_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/a1_launch_background</item>
    </style>
</resources>
